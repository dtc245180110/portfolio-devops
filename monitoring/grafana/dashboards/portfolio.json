{
  "uid": "portfolio-overview",
  "title": "Portfolio - Giám sát hệ thống",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Targets đang UP", "gridPos": {"h":4,"w":6,"x":0,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","expr":"sum(up)"} ] },
    { "id": 2, "type": "stat", "title": "Số container portfolio", "gridPos": {"h":4,"w":6,"x":6,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","expr":"count(container_memory_usage_bytes{name=~'portfolio-.+'})"} ] },
    { "id": 3, "type": "stat", "title": "Nginx (1 = chạy)", "gridPos": {"h":4,"w":6,"x":12,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","expr":"nginx_up"} ] },
    { "id": 4, "type": "stat", "title": "MySQL (1 = chạy)", "gridPos": {"h":4,"w":6,"x":18,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","expr":"mysql_up"} ] },
    { "id": 5, "type": "timeseries", "title": "CPU theo container (%)", "gridPos": {"h":8,"w":12,"x":0,"y":4},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"percent"},"overrides":[]},
      "targets": [ {"refId":"A","legendFormat":"{{name}}","expr":"sum by (name) (rate(container_cpu_usage_seconds_total{name=~'portfolio-.+'}[1m])) * 100"} ] },
    { "id": 6, "type": "timeseries", "title": "RAM theo container", "gridPos": {"h":8,"w":12,"x":12,"y":4},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"bytes"},"overrides":[]},
      "targets": [ {"refId":"A","legendFormat":"{{name}}","expr":"container_memory_usage_bytes{name=~'portfolio-.+'}"} ] },
    { "id": 7, "type": "timeseries", "title": "Nginx - số request/giây", "gridPos": {"h":8,"w":12,"x":0,"y":12},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","legendFormat":"requests/s","expr":"rate(nginx_http_requests_total[1m])"} ] },
    { "id": 8, "type": "timeseries", "title": "Nginx - kết nối đang hoạt động", "gridPos": {"h":8,"w":12,"x":12,"y":12},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","legendFormat":"active","expr":"nginx_connections_active"} ] },
    { "id": 9, "type": "timeseries", "title": "MySQL - số kết nối", "gridPos": {"h":8,"w":12,"x":0,"y":20},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","legendFormat":"threads connected","expr":"mysql_global_status_threads_connected"} ] },
    { "id": 10, "type": "timeseries", "title": "MySQL - số truy vấn/giây", "gridPos": {"h":8,"w":12,"x":12,"y":20},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [ {"refId":"A","legendFormat":"queries/s","expr":"rate(mysql_global_status_queries[1m])"} ] }
  ]
}
